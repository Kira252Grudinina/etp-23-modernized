FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir gradio requests

# Copy Gradio app
COPY src/sexism_detector/api/gradio_app.py .

# Expose Gradio port
EXPOSE 7860

# Run Gradio
CMD ["python", "gradio_app.py"]
